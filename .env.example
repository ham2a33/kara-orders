ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://kara:kara_password@db:5432/kara_orders
SECRET_KEY=replace-with-a-long-random-secret-value-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=12
AUTH_REFRESH_COOKIE_NAME=kara_orders_refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
POSTGRES_DB=kara_orders
POSTGRES_USER=kara
POSTGRES_PASSWORD=kara_password
FRONTEND_PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kara-orders
OPENAI_API_KEY=
